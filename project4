plt.close()

# Fig 5.2: Salary Distribution
plt.figure()
sns.histplot(data=df_clean, x='Salary', kde=True, color='#1f77b4', bins=15)
plt.title('Salary Distribution Profile with Density Overlay', fontsize=12, fontweight='bold', pad=12)
plt.xlabel('Annual Salary ($)')
plt.ylabel('Frequency Count')
plt.tight_layout()
plt.savefig('charts/fig2_salary.png', dpi=300)
plt.close()

# Fig 5.3: Scatter Performance vs Salary
plt.figure()
sns.scatterplot(data=df_clean, x='Salary', y='Performance_Score', hue='Turnover', palette={0: '#2ca02c', 1: '#d62728'}, alpha=0.7)
plt.title('Salary Level vs Performance Score Matrix by Attrition Status', fontsize=11, fontweight='bold', pad=12)
plt.xlabel('Salary ($)')
plt.ylabel('Performance Rating (1-5)')
plt.legend(title='Turnover Status', labels=['Active (0)', 'Left (1)'])
plt.tight_layout()
plt.savefig('charts/fig3_scatter.png', dpi=300)
plt.close()

# Fig 5.4: Turnover by Salary Band
plt.figure()
sns.barplot(data=salary_matrix, x='Salary_Band', y='Turnover_Rate', palette='Reds_r')
plt.title('Turnover Rate Breakdown by Salary Band', fontsize=12, fontweight='bold', pad=12)
plt.xlabel('Segmented Salary Tiers')
plt.ylabel('Observed Attrition Rate (%)')
plt.tight_layout()
plt.savefig('charts/fig4_turnover.png', dpi=300)
plt.close()

